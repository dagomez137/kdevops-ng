# VFIO passthrough: hand each listed device to vfio-pci when it appears,
# and let the kvm group open the /dev/vfio nodes.
# Rendered from: templates/vfio-udev.rules.j2
# Deploy: sudo tee /etc/udev/rules.d/10-vfio-kvm.rules
# Applies from the next boot; docs/usage.md "vfio" moves a device a host
# driver holds now.
SUBSYSTEM=="vfio", OWNER="root", GROUP="kvm", MODE="0660"
{% for dev in pci_passthrough | default([]) %}
ACTION=="add", SUBSYSTEM=="pci", KERNEL=="{{ dev.addr }}", ATTR{driver_override}="vfio-pci"
{% endfor %}
