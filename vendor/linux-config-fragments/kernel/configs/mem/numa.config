# Help: NUMA support
#
# X86_64_ACPI_NUMA reads the node layout from the SRAT, the table QEMU
# describes a guest's -numa nodes in. It defaults to y but has a prompt,
# so an allnoconfig base drops it and the kernel falls back to one fake
# node. Other architectures ignore it.
# See: arch/x86/Kconfig (X86_64_ACPI_NUMA)
CONFIG_SMP=y
CONFIG_NUMA=y
CONFIG_X86_64_ACPI_NUMA=y
