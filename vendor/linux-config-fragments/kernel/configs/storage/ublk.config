# Help: Userspace block driver (ublk)
#
# ublk_drv exposes the io_uring command interface a userspace block
# device server attaches to; the blktests ublk group drives it with
# the suite's bundled miniublk server.
#
# Prerequisites inlined per the self-containment rule:
# - IO_URING=y gates BLK_DEV_UBLK (the control path is io_uring
#   commands).
#
# Layer builtin/storage/ublk.config to build it in (=y) for a
# no-modprobe boot.
# See: drivers/block/Kconfig
# See: https://docs.kernel.org/block/ublk.html

#
# Inlined prerequisites
#
CONFIG_IO_URING=y

#
# Userspace block driver
#
CONFIG_BLK_DEV_UBLK=m
