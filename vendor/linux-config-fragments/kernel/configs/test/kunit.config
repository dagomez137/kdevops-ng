# Help: KUnit kernel unit testing framework, on-demand
#
# KUNIT is tristate. KUNIT=y is chosen so the framework's executor and
# its debugfs interface are built in and available from early boot.
# Suites do not run at boot: KUNIT_AUTORUN_ENABLED=n initializes every
# suite (its debugfs run and results nodes exist) without executing
# it, so a commander re-runs suites on demand through
# /sys/kernel/debug/kunit/<suite>/run. Opt back into boot-time runs
# with test/kunit-autorun.config, or per boot with kunit.autorun=1 on
# the kernel command line.
#
# KUNIT_ALL_TESTS=m builds every test the enabled subsystems allow as
# a loadable module, so the full suite catalog is available; tests
# whose subsystem is absent from the final config are skipped by
# Kconfig, and boolean-only tests stay built-in. The builtin/ mirror
# sets it =y for a module-free kernel.
# See: https://docs.kernel.org/dev-tools/kunit/
CONFIG_KUNIT=y
CONFIG_KUNIT_DEFAULT_ENABLED=y
# CONFIG_KUNIT_AUTORUN_ENABLED is not set
CONFIG_KUNIT_DEBUGFS=y
CONFIG_KUNIT_ALL_TESTS=m
