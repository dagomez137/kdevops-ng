# Help: run every enabled KUnit suite once at boot
#
# The kunit fragment leaves suites initialized but not executed, for
# on-demand runs through debugfs. This opt-in flips the default back:
# built-in suites run during kernel init and modular suites run on
# load, each writing its KTAP to the kernel log. The same choice is
# available per boot without rebuilding, as kunit.autorun=0/1 on the
# kernel command line.
# See: https://docs.kernel.org/dev-tools/kunit/
CONFIG_KUNIT=y
CONFIG_KUNIT_AUTORUN_ENABLED=y
