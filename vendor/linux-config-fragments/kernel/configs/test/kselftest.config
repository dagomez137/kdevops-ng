# Help: Kernel selftests (kselftest) collection prerequisites
#
# What the portable syscall-level collections of the kernel's own
# selftests (tools/testing/selftests) exercise: namespaces (pidfd,
# proc, mount_setattr), System V IPC and POSIX message queues (mqueue;
# SYSVIPC is the IPC_NS prerequisite), kcmp via CHECKPOINT_RESTORE,
# seccomp filters, the cgroup controllers the cgroup collection
# drives, the sync-file validation framework (sync; SYNC_FILE and
# DEBUG_FS are its prerequisites), and the loop device the exec
# collection mounts through. Each symbol traces to a
# tools/testing/selftests/<collection>/config request or to a runtime
# requirement those configs leave implicit (POSIX_MQUEUE, SYSVIPC).
#
# The lib collection loads in-kernel test modules on demand:
# TEST_BITMAP, TEST_BITOPS and PRIME_NUMBERS here; the sysctl and
# kmod collections' TEST_SYSCTL and TEST_KMOD live in
# test/selftests.config. RUNTIME_TESTING_MENU=y inlined per the
# self-containment rule. Loaded on demand by the test runner; no
# builtin/ counterpart needed.
#
# Deliberate omissions: FUSE_FS (memfd's FUSE subtest) stays with the
# base config, since =m here would downgrade a base that needs it
# built in (a virtiofs root); GENERIC_ENTRY (syscall_user_dispatch)
# and PAGE_COUNTER (memcg) are arch-selected, not user-selectable;
# STAGING in the upstream sync/config predates SW_SYNC's move out of
# staging.
# See: https://docs.kernel.org/dev-tools/kselftest.html

CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y

CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_PROC_FS=y

CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y

CONFIG_DEBUG_FS=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y

CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=m

CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_TEST_BITMAP=m
CONFIG_TEST_BITOPS=m
CONFIG_PRIME_NUMBERS=m
