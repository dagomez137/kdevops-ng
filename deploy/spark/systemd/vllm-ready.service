#
# Readiness as a unit rather than a poll loop in a driver script: gate on an
# actual /health response. RemainAfterExit so later bench instances see it
# active without re-probing an already-warm engine.
[Unit]
Description=Wait for the vLLM engine to accept requests
Requires=vllm-serve.service
After=vllm-serve.service

[Service]
Type=oneshot
RemainAfterExit=yes
StateDirectory=kvcache
# API_PORT comes from the same env file the engine reads; on a host that
# also runs the Windmill stack, 8000 belongs to its reverse proxy, so the
# engine must sit elsewhere (the flow defaults to 8200 for this reason).
EnvironmentFile=%S/kvcache/vllm-serve.env
ExecStart=%S/kvcache/pkgs/curl/bin/curl --retry 360 --retry-delay 5 \
    --retry-all-errors --fail --silent --show-error \
    http://127.0.0.1:${API_PORT}/health
TimeoutStartSec=infinity
SyslogIdentifier=vllm-ready
